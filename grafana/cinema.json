{
  "uid": "cinema",
  "title": "Online Cinema",
  "editable": true,
  "schemaVersion": 41,
  "refresh": "30s",
  "time": {
    "from": "now-8d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Retention по когортам",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT toString(date) AS \"Когорта\",\n    maxIfOrNull(value, metric = 'retention_d0') AS \"Day 0\",\n    maxIfOrNull(value, metric = 'retention_d1') AS \"Day 1\",\n    maxIfOrNull(value, metric = 'retention_d2') AS \"Day 2\",\n    maxIfOrNull(value, metric = 'retention_d3') AS \"Day 3\",\n    maxIfOrNull(value, metric = 'retention_d4') AS \"Day 4\",\n    maxIfOrNull(value, metric = 'retention_d5') AS \"Day 5\",\n    maxIfOrNull(value, metric = 'retention_d6') AS \"Day 6\",\n    maxIfOrNull(value, metric = 'retention_d7') AS \"Day 7\"\nFROM daily_metrics FINAL\nWHERE metric LIKE 'retention_d%' AND $__dateFilter(date)\nGROUP BY date\nORDER BY date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "max": 0.5,
          "color": {
            "mode": "continuous-blues"
          },
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "color-background",
              "mode": "gradient"
            }
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "",
                  "color": "transparent"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Когорта"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "unit",
                "value": "string"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "DAU",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toDateTime(date) AS time, value AS DAU\nFROM daily_metrics FINAL\nWHERE metric = 'dau' AND $__dateFilter(date)\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Конверсия и retention",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toDateTime(date) AS time,\n    maxIfOrNull(value, metric = 'view_conversion') AS \"Конверсия просмотра\",\n    maxIfOrNull(value, metric = 'retention_d1') AS \"Retention D1\",\n    maxIfOrNull(value, metric = 'retention_d7') AS \"Retention D7\"\nFROM daily_metrics FINAL\nWHERE $__dateFilter(date)\nGROUP BY date\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Среднее время просмотра",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toDateTime(date) AS time, value AS \"Среднее время\"\nFROM daily_metrics FINAL\nWHERE metric = 'avg_watch_seconds' AND $__dateFilter(date)\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Топ фильмов за последний день",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT movie_id AS \"Фильм\", views AS \"Просмотры\"\nFROM top_movies FINAL\nWHERE date = (SELECT max(date) FROM top_movies)\nORDER BY rank"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "Фильм",
        "showValue": "always",
        "legend": {
          "showLegend": false
        }
      }
    }
  ]
}